@startuml DCD-fragment-S4
' Working input to DCD-integrated.puml
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

package shortfall {
  class HandleShortfallHandler <<controller>> {
    - orders : OrderRepository
    - stockLots : StockLotRepository
    - policy : AllocationPolicy
    - audit : AuditContext
    - clock : Clock
    + resolveShortfall(orderLineId : OrderLineId) : Result<ShortfallResolutionResult>
  }

  class ShortfallResolutionResult <<DTO>> {
    + lineResult : LineAllocationResult
    + resolutionStatus : ShortfallResolutionStatus
    + customerContactRequired : boolean
  }

  enum ShortfallResolutionStatus {
    RESOLVED
    REDUCED
    REMOVED
    UNRESOLVED
  }

  interface AllocationPolicy {
    + priorityFor(order : Order) : Priority
  }
  class FirstComeFirstServedAllocationPolicy {
    + priorityFor(order : Order) : Priority
  }
  enum Priority
}


package shared {
  class Order <<entity>> {
    + lineOf(orderLineId : OrderLineId) : OrderLine
    + productOf(orderLineId : OrderLineId) : ProductId
    + resolveShortfall(orderLineId : OrderLineId, lots : List<StockLot>, policy : AllocationPolicy, user : UserId, now : DateTime) : Result<ShortfallResolutionResult>
  }

  class OrderLine <<entity>> {
    - acceptsReducedQuantity : boolean
    - acceptsRemoval : boolean
    - substitutes : List<ProductId>
    + resolveShortfall(lots : List<StockLot>, policy : AllocationPolicy, user : UserId, now : DateTime) : Result<LineAllocationResult>
    + outstandingQuantity() : Quantity
    + applyCustomerPreference() : Result<Void>
    + traceEntries() : List<TraceEntry>
  }

  class Allocation <<entity>> {
    + Allocation(lot : StockLot, quantity : Quantity, user : UserId, now : DateTime)
    + traceEntry() : TraceEntry
  }

  class LineAllocationResult <<DTO>> {
    + entries : List<TraceEntry>
    + totalAllocated : Quantity
    + shortfall : Quantity
  }
  class TraceEntry <<DTO>>

  class StockLot <<entity>> {
    + availableQuantity() : Quantity
    + allocate(quantity : Quantity) : Result<Void>
    + traceDetails() : TraceDetails
  }
  class TraceDetails <<value>>
  class Product <<entity>>
  enum Role {
    VOLUNTEER
    STAFF
    MANAGER
    + isAtLeast(role : Role) : boolean
  }

  interface OrderRepository {
    + findByLine(orderLineId : OrderLineId) : Optional<Order>
    + save(order : Order) : void
  }
  interface StockLotRepository {
    + findAvailable(productId : ProductId) : List<StockLot>
    + save(lot : StockLot) : void
  }
  interface AuditContext {
    + currentUser() : UserId
    + currentRole() : Role
  }
  interface Clock {
    + now() : DateTime
  }
}


HandleShortfallHandler ..> OrderRepository
HandleShortfallHandler ..> StockLotRepository
HandleShortfallHandler ..> AllocationPolicy
HandleShortfallHandler ..> AuditContext
HandleShortfallHandler ..> Clock
HandleShortfallHandler ..> Role
HandleShortfallHandler ..> Order
HandleShortfallHandler ..> ShortfallResolutionResult : returns

AllocationPolicy <|.. FirstComeFirstServedAllocationPolicy
FirstComeFirstServedAllocationPolicy ..> Order
Order "1" *-- "1..*" OrderLine : lines
OrderLine "1" *-- "0..*" Allocation : is fulfilled by
Allocation "0..*" --> "1" StockLot : draws from
StockLot "0..*" --> "1" Product : product
StockLot "1" *-- "1" TraceDetails : trace
OrderLine ..> LineAllocationResult : creates
Allocation ..> TraceEntry : creates
LineAllocationResult *-- TraceEntry
ShortfallResolutionResult *-- LineAllocationResult
Order ..> AllocationPolicy
OrderLine ..> AllocationPolicy
OrderLine ..> StockLot
@enduml
